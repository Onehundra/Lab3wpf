<UserControl x:Class="Labb3_NET22.EditQuizView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Labb3_NET22"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="LightBlue">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <TextBlock Text="Edit Quiz" FontSize="24" FontWeight="Bold" Margin="10"/>

            <Button Content="Load Quiz" Width="150" Margin="5" Click="LoadQuiz_Click"/>

            <ListBox x:Name="QuestionListBox" Width="400" Height="150" Margin="10" 
                     SelectionChanged="QuestionListBox_SelectionChanged"/>

            <TextBox x:Name="EditQuestionBox" Width="400" Margin="5" Text="Selected question will show here"/>
            <TextBox x:Name="EditAnswer1Box" Width="400" Margin="2" Text="Answer 1"/>
            <TextBox x:Name="EditAnswer2Box" Width="400" Margin="2" Text="Answer 2"/>
            <TextBox x:Name="EditAnswer3Box" Width="400" Margin="2" Text="Answer 3"/>
            <TextBox x:Name="EditAnswer4Box" Width="400" Margin="2" Text="Answer 4"/>
            <TextBox x:Name="EditCorrectBox" Width="50" Margin="5" Text="0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Save Changes" Width="120" Margin="5" Click="SaveChanges_Click"/>
                <Button Content="Delete Question" Width="120" Margin="5" Click="DeleteQuestion_Click"/>
                <Button Content="Return" Width="120" Margin="5" Click="ReturnToMenu_Click"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</UserControl>
